{
  "autoCompactWindow": 250000,
  "_remove_env": [
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE"
  ],
  "permissions": {
    "ask": [
      "Bash(git push*)",
      "Bash(git commit --amend*)",
      "Bash(git * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.test)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.production)",
      "Edit(**/.env.*.local)",
      "Read(**/credentials.json)",
      "Edit(**/credentials.json)",
      "Read(**/secrets.json)",
      "Edit(**/secrets.json)",
      "Read(**/id_rsa*)",
      "Edit(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Edit(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Edit(**/.npmrc)",
      "Read(**/.pgpass)",
      "Edit(**/.pgpass)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Read|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/env-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/post-edit.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/context-threshold.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/study-keyword.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/precompact-snapshot.sh",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/compact-handoff.sh",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/doctor-sessionstart.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/kit/bin/statusline.sh"
  }
}